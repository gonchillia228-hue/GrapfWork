<Window x:Class="GraphApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Graph Shortest Paths" Height="600" Width="900">



    <Grid>
        <TabControl Background="Transparent">

            <!-- Вкладка 1: Введення графа вручну -->
            <TabItem Header="Введення графа">
                <StackPanel Margin="10" Background="#80FFFFFF">
                    <TextBlock Text="Введіть ребра у форматі: from to weight" Margin="0,0,0,5"/>
                    <TextBox x:Name="ManualEdgesTextBox" Height="200" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content="Додати ребра" Click="AddEdgesButton_Click" Width="120"/>
                        <Button Content="Очистити" Click="ClearEdgesButton_Click" Width="80" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Вкладка 2: Завантаження графа з файлу -->
            <TabItem Header="Завантажити граф">
                <StackPanel Margin="10" Background="#80FFFFFF">
                    <Button Content="Вибрати файл" Click="LoadGraphButton_Click" Width="120"/>
                    <TextBlock x:Name="FilePathTextBlock" Margin="0,5,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- Вкладка 3: Алгоритми пошуку шляхів -->
            <TabItem Header="Алгоритми">
                <StackPanel Margin="10" Background="#80FFFFFF">
                    <ComboBox x:Name="AlgorithmComboBox" Width="200" Margin="0,0,0,5">
                        <ComboBoxItem Content="Floyd-Warshall" IsSelected="True"/>
                        <ComboBoxItem Content="Dantzig"/>
                    </ComboBox>
                    <Button Content="Обчислити шляхи" Click="ComputePathsButton_Click" Width="150"/>
                    <TextBox x:Name="ResultTextBox" Height="300" Margin="0,5,0,0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </TabItem>

            <!-- Вкладка 4: Візуалізація -->
            <TabItem Header="Візуалізація">
                <Grid>
                    <!-- Прямокутник-фон -->
                    <Rectangle x:Name="GraphBackground" Fill="White" RadiusX="10" RadiusY="10" Margin="10"/>

                    <!-- Canvas для графа поверх прямокутника -->
                    <Canvas x:Name="GraphCanvas" Background="Transparent"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>